# =============================================================================
# Copia este archivo a .env y completa los valores.
#   cp .env.example .env          (Linux/macOS)
#   Copy-Item .env.example .env   (Windows PowerShell)
# No subas .env al repositorio: contiene secretos.
# =============================================================================

# ─── Telegram (obligatorio) ──────────────────────────────────────────────────
# Token entregado por @BotFather. Obligatorio; sin él el bot no arranca.
TELEGRAM_BOT_TOKEN=

# Lista CSV de chat IDs autorizados. Obligatorio; una lista vacía es fatal.
# Obtén cada ID ejecutando: python get_chat_id.py
ALLOWED_CHAT_IDS=

# ─── Transporte del agente ───────────────────────────────────────────────────
# server (default): `opencode serve` por HTTP/SSE — permisos interactivos y
#   streaming en vivo. Requiere OPENCODE_SERVER_PASSWORD.
# cli: rollback de una sola ejecución (`opencode run`); no necesita password ni
#   ofrece diálogos de permiso.
OPENCODE_BACKEND=server

# ─── OpenCode (común) ────────────────────────────────────────────────────────
# Directorio de trabajo por defecto. Cada chat puede sobreescribirlo con /config.
# Default: la raíz del repositorio (por eso queda comentada: vacío no es válido).
# OPENCODE_WORKDIR=C:/ruta/al/proyecto

# Timeout del prompt en segundos. Se suspende mientras hay un permiso pendiente.
OPENCODE_TIMEOUT=300

# Ruta al ejecutable de OpenCode. Vacío = autodetección (PATH / npm).
OPENCODE_CMD=

# Segundos que un diálogo de permiso espera a un humano.
# 0 (default) = esperar indefinidamente: el agente no avanza sin autorización,
#   aunque tarde horas. >0 = auto-rechazar tras N segundos como red de seguridad.
OPENCODE_PERMISSION_TIMEOUT=0

# ─── Servidor OpenCode (solo con OPENCODE_BACKEND=server) ────────────────────
# Host de escucha. Loopback únicamente por defecto: el bot es el único cliente
# del agente. Valores válidos: 127.0.0.1, ::1, localhost.
OPENCODE_SERVER_HOST=127.0.0.1

# Puerto del servidor.
OPENCODE_SERVER_PORT=4096

# Password de Basic auth. OBLIGATORIO en modo server: si queda vacío el bot
# falla al arrancar con un mensaje accionable. Genéralo con:
#   openssl rand -hex 16
# Nunca se escribe en los logs.
OPENCODE_SERVER_PASSWORD=

# Binario con el que se lanza `opencode serve`. Vacío = usa OPENCODE_CMD.
OPENCODE_SERVER_BINARY=

# 1 solo si el bot y el agente viven en máquinas distintas. Habilita un host
# no-loopback. Nunca para clientes (Telegram/APK): esos hablan con el bot.
# Protégelo con TLS, firewall y una contraseña fuerte.
OPENCODE_SERVER_ALLOW_REMOTE=

# ─── OpenAI (opcional: transcripción de notas de voz) ────────────────────────
OPENAI_API_KEY=

# ─── Logging / diagnóstico (opcional) ────────────────────────────────────────
# Formato de los logs: text (default) o json.
BOT_LOG_FORMAT=text

# Ruta del archivo de log.
# Default: bot.log en la raíz del repositorio (comentada: vacío no es válido).
# BOT_LOG_FILE=C:/ruta/al/bot.log

# 1 = explorar el esquema de la base de OpenCode al arrancar (diagnóstico).
EXPLORE_DB=
